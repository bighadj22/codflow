---
import BaseLayout from "@/layouts/BaseLayout.astro";
import GateSpinner from "@/features/auth/components/GateSpinner";
import CustomerTagsPageApp from "@/features/customer-tags/components/CustomerTagsPageApp";
---

<BaseLayout title="CodFlow">
  <main class="min-h-screen">
    <div data-gate-spinner="required" class="flex min-h-screen items-center justify-center" aria-busy="true">
      <GateSpinner branded />
    </div>
    <div data-auth-gate="required" hidden>
      <CustomerTagsPageApp client:only="react" />
    </div>
  </main>
</BaseLayout>
