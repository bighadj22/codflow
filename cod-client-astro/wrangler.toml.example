# ─────────────────────────────────────────────────────────────────────────────
# CodFlow dashboard (Astro) — wrangler config template.
# Copy to wrangler.toml and fill in YOUR Cloudflare resource IDs:
#   cp wrangler.toml.example wrangler.toml
# (wrangler.toml is gitignored — your real IDs never get committed.)
#
# The dashboard is static-first: pages are prerendered assets served from
# [assets]; the Worker runs only for /api/auth/* and /mcp/oauth/login.
# It shares cod-server's D1 database (auth users/scopes live there) and
# needs one KV namespace for auth rate limiting + sessions.
# ─────────────────────────────────────────────────────────────────────────────

name = "codflow-dashboard"
# Optional — omit to use the account you logged in with (`wrangler whoami`).
# account_id = "your-cloudflare-account-id"
compatibility_date = "2026-08-25"
compatibility_flags = [
  "nodejs_compat",
  # Astro runtime-detection trap: without this, process v2 makes Astro think
  # it is Node and serve "[object Object]" responses.
  "disable_nodejs_process_v2",
]

[assets]
directory = "./dist"
binding = "ASSETS"
not_found_handling = "single-page-application"
run_worker_first = ["/api/auth/*", "/mcp/oauth/login"]

[[d1_databases]]
# MUST be the same D1 database cod-server binds to — the dashboard's
# better-auth tables live in cod-server's schema (users, accounts, sessions...).
binding       = "DB"
database_name = "codflow-db"
database_id   = "<your-d1-database-id>"

[[kv_namespaces]]
binding = "RATE_LIMIT_KV"
id      = "<your-kv-namespace-id>"

[vars]
# Your deployed dashboard origin (also add it to cod-server's TRUSTED_ORIGINS).
PUBLIC_APP_URL = "https://dashboard.example.com"
# Your deployed cod-server origin.
PUBLIC_API_URL = "https://api.example.com"
# Comma-separated: every origin allowed to use the auth cookies (dashboard
# workers.dev URL + custom domain; localhost origins are added automatically
# in development).
PUBLIC_TRUSTED_ORIGINS = "https://codflow-dashboard.<your-subdomain>.workers.dev,https://dashboard.example.com"

[observability]
enabled = true

[dev]
port = 8788

# ── Secrets (never in this file) ─────────────────────────────────────────────
# wrangler secret put BETTER_AUTH_SECRET        # must MATCH cod-server's
# wrangler secret put MCP_LOGIN_TICKET_SECRET   # must MATCH cod-server's
#
# Local development: copy .dev.vars.example → .dev.vars and set both there.
# Build-time client env: copy .env.example → .env (PUBLIC_API_URL only).
