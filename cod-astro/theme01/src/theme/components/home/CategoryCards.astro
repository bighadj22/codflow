---
// ── STREAMING COMPONENT ──
// Category image cards grid (first 4 categories)
import { Image } from "astro:assets";
import { fetchCategoriesRaw } from "@/core/api/client";
import type { StoreFrontContent } from "@/theme/config/content";

interface Props {
  content: StoreFrontContent;
}

const { content } = Astro.props;
const categories = await fetchCategoriesRaw();
const topCategories = categories
  .sort((a: any, b: any) => (a.position ?? 0) - (b.position ?? 0))
  .slice(0, 4);
---

{topCategories.length > 0 && (
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
      {topCategories.map((cat: any) => (
        <a
          href={`/category/${cat.slug}`}
          class="group relative overflow-hidden aspect-[4/5] sm:aspect-[3/4] active:scale-[0.98] transition-all duration-500 shadow-md hover:shadow-2xl"
          style="border-radius: var(--radius-card)"
          aria-label={content.ariaBrowseCategoryProducts?.replace("{category}", cat.name)}
        >
          {cat.imageUrl ? (
            <Image
              src={cat.imageUrl}
              alt={cat.name}
              width={400}
              height={533}
              format="webp"
              quality={90}
              loading="lazy"
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-out"
            />
          ) : (
            <div
              class="w-full h-full"
              style="background: linear-gradient(135deg, color-mix(in srgb, var(--clr-primary) 10%, white) 0%, color-mix(in srgb, var(--clr-primary) 5%, white) 100%)"
            ></div>
          )}
          
          {/* Subtle overlay */}
          <div
            class="absolute inset-0 bg-black/30 group-hover:bg-black/50 transition-colors duration-500 flex flex-col items-center justify-center text-center p-4"
          >
            <h3 class="text-white text-lg sm:text-2xl font-black mb-4 group-hover:-translate-y-1 transition-transform duration-500">
              {cat.name}
            </h3>
            <span class="text-[0.625rem] sm:text-[0.75rem] font-black uppercase tracking-widest px-6 py-2.5 rounded-lg opacity-0 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-500" style="background: var(--clr-surface); color: var(--clr-text)">
              {content.viewProduct}
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>
)}
