{
  "name": "codflow-os-theme01",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-04-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true
  }
  // COD_SERVER_URL is injected at deploy time from the unified root .env
  // (COD_SERVER_URL) by `npm run deploy` → scripts/deploy.mjs — never hardcode
  // it here. Local dev reads it from .dev.vars (see cod-server/scripts/cloud-env.mjs).
  // STORE_API_KEY is a secret — set it via `wrangler secret put STORE_API_KEY`
  // (do NOT put the real key here).
}