{
  "name": "codflow-os-theme01",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-04-22",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "routes": [
    {
      "pattern": "demo.codflow.store/*",
      "zone_name": "codflow.store"
    }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true
  }
}