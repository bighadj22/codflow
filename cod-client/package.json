{
  "name": "codflow-client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "start": "next start",
    "db:migrate:remote": "cd ../cod-server && npm run db:migrate:remote",
    "db:seed:local": "cd ../cod-server && npm run db:seed:local",
    "db:migrate:local": "cd ../cod-server && npm run db:migrate:local",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:unit": "vitest --run tests/unit",
    "test:integration": "vitest --run tests/integration",
    "test:property": "vitest --run tests/property",
    "test:e2e": "vitest --run tests/e2e",
    "test:ci": "vitest --run --coverage --reporter=json --reporter=html",
    "check:reads": "bash scripts/check-direct-reads.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@better-auth/oauth-provider": "^1.7.1",
    "better-auth": "^1.7.1",
    "better-auth-cloudflare": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.33.0",
    "next": "16.3.1",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260820.1",
    "@opennextjs/cloudflare": "1.20.4",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "fast-check": "^4.9.0",
    "glob": "^13.0.6",
    "jsdom": "^30.0.1",
    "miniflare": "^4.20260730.0",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vercel": "^59",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
