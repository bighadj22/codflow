{
  "name": "codflow-client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "npm run build:worker && wrangler dev",
    "deploy": "npm run build:worker && wrangler deploy",
    "start": "next start",
    "db:migrate:remote": "cd ../cod-server && npm run db:migrate:remote",
    "db:seed:local": "cd ../cod-server && npm run db:seed:local",
    "db:migrate:local": "cd ../cod-server && npm run db:migrate:local",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:unit": "vitest --run tests/unit",
    "test:integration": "vitest --run tests/integration",
    "test:property": "vitest --run tests/property",
    "test:e2e": "vitest --run tests/e2e",
    "test:ci": "vitest --run --coverage --reporter=json --reporter=html",
    "check:reads": "bash scripts/check-direct-reads.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@better-auth/oauth-provider": "^1.6.29",
    "better-auth": "^1.6.8",
    "better-auth-cloudflare": "^0.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^0.577.0",
    "next": "15.5.15",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "shadcn": "^4.0.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260313.1",
    "@opennextjs/cloudflare": "1.19.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^28.0.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^2.1.9",
    "@vitest/ui": "^2.1.9",
    "fast-check": "^4.6.0",
    "glob": "^13.0.6",
    "jsdom": "^27.0.1",
    "miniflare": "^4.20260312.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vercel": "^32",
    "vitest": "^2.1.9",
    "wrangler": "^4.65.0"
  }
}
