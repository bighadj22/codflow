# CodFlow dashboard (cod-client) — local development secrets
# Copy this file to .dev.vars and fill in your values.
# (.dev.vars is gitignored — your real values never get committed.)
#
# These override the [vars] block in wrangler.toml for local `wrangler dev`.

# Public URL of the dashboard (Better Auth base URL + email sender domain).
# Leave as-is for local development against cod-server on port 8787.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public URL of the cod-server API Worker.
NEXT_PUBLIC_WORKER_URL=http://localhost:8787

# REQUIRED — secret used to sign auth sessions/JWTs.
# Generate with:  openssl rand -base64 32
# In production, set via `wrangler secret put BETTER_AUTH_SECRET` (do NOT put it in wrangler.toml).
BETTER_AUTH_SECRET=