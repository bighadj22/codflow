{
  "name": "codflow-server",
  "version": "1.0.0",
  "description": "COD Flow Backend Worker - Cloudflare Workers API",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --port 8787 --persist-to ../.wrangler-shared",
    "deploy": "wrangler deploy",
    "build:ci": "wrangler deploy --dry-run --outdir dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply codflow-db --local --persist-to ../.wrangler-shared",
    "db:migrate:remote": "wrangler d1 migrations apply codflow-db --remote",
    "db:seed:local": "node scripts/seed-local.mjs",
    "db:setup:local": "npm run db:migrate:local && npm run db:seed:local",
    "db:validate": "npx tsx scripts/validate-migration.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:unit": "vitest --run tests/unit",
    "test:integration": "vitest --run tests/integration",
    "test:property": "vitest --run tests/property",
    "test:performance": "vitest --run tests/performance",
    "test:ci": "vitest --run --coverage --reporter=json --reporter=html"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1017.0",
    "@aws-sdk/s3-request-presigner": "^3.1017.0",
    "@better-auth/oauth-provider": "^1.6.8",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@noble/hashes": "^2.2.0",
    "agents": "^0.11.5",
    "ai": "^6.0.158",
    "better-auth": "^1.6.8",
    "drizzle-orm": "^0.36.4",
    "hono": "^4.6.14",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "@hono/zod-openapi": "^1.2.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^2.1.9",
    "better-sqlite3": "^12.8.0",
    "drizzle-kit": "^0.30.1",
    "fast-check": "^4.6.0",
    "miniflare": "^4.20260312.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9",
    "vitest-environment-miniflare": "^2.14.4",
    "wrangler": "^4.84.1"
  }
}
