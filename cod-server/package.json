{
  "name": "codflow-server",
  "version": "1.0.0",
  "description": "COD Flow Backend Worker - Cloudflare Workers API",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --port 8787 --persist-to ../.wrangler-shared",
    "deploy": "wrangler deploy",
    "build:ci": "wrangler deploy --dry-run --outdir dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply codflow-db --local --persist-to ../.wrangler-shared",
    "db:migrate:remote": "wrangler d1 migrations apply codflow-db --remote",
    "db:seed:local": "node scripts/seed-local.mjs",
    "db:setup:local": "npm run db:migrate:local && npm run db:seed:local",
    "db:validate": "npx tsx scripts/validate-migration.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:unit": "vitest --run tests/unit",
    "test:integration": "vitest --run tests/integration",
    "test:property": "vitest --run tests/property",
    "test:performance": "vitest --run tests/performance",
    "test:ci": "vitest --run --coverage --reporter=json --reporter=html"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1115.0",
    "@aws-sdk/s3-request-presigner": "^3.1115.0",
    "@better-auth/oauth-provider": "^1.7.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@noble/hashes": "^2.3.0",
    "agents": "^0.21.0",
    "ai": "^7.0.70",
    "better-auth": "^1.7.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260820.1",
    "@hono/zod-openapi": "^1.6.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.10",
    "fast-check": "^4.9.0",
    "miniflare": "^4.20260730.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "vitest-environment-miniflare": "^2.14.4",
    "wrangler": "^4.125.0"
  }
}
